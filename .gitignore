# 构建产物
/lmby
/lmby.exe
/dist/
*.tgz
*.tar.gz

# 运行时数据（绝不入库）
/data/
/config.toml

# 前端依赖与构建产物
/web/node_modules/
#
# 说明：web/dist/index.html 是「占位页」，必须入库 ——
# go:embed 至少要匹配到一个文件，否则没构建前端时 go build 会失败。
# 执行 npm run build 后它会变成真实的构建产物（会在 git 里显示为已修改），
# 提交前用 `task web:restore-placeholder` 恢复即可。
/web/dist/assets/
/web/dist/*.map

# 真实的内网坐标（地址 / 共享 / 账号）—— 公开仓库里不写，只在本地保留
# 覆盖 local-notes.md（内网坐标明细）、local-handoff.md（换机交接文档）、local-tools/（内网小工具）
/docs/local-*

# 验收脚本跑出来的产物（截图与报告本机看，不入库）
/shots*/
/*-ui-report.txt
/*-report.txt

# libass（特效字幕）的运行时文件：构建时从 libass-wasm 复制（web/scripts/copy-octopus.mjs），
# 属生成物，不入库。
/web/public/
/web/dist/subtitles-octopus/

# Python 字节码缓存（scripts/release 下的发布脚本会生成）
__pycache__/
*.pyc
