# 统一使用 LF，避免 Windows/Linux 混用时出现行尾问题
* text=auto eol=lf

*.go text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
Taskfile.yml text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.tgz binary
*.gz binary
*.zip binary
*.map binary
